  "interpretation": {
    "anomaly_calibration": "empirical null p values on held out natural are near uniform (ks p 0.765 anomaly, 0.560 mahalanobis); platt g3 brier 0.0024 ece 0.0048; g5 brier 0.220 ece 0.103",
    "caveats": "synthetic data; primary profile keys use 6 decimals; exact float keys give 76 g3 profiles with the same 0.386667 ceiling; anomaly and mahalanobis are reference based scores",
    "collision_adjusted_accuracy": "rf and hgb equal the tie aware g3 ceiling 0.386667; logreg 0.293333 and mlp 0.191667; g6 rf 0.005 is below profile chance 0.085",
    "effective_classes": "g3 has 58 modal labels and hill2 52.08 over 150 nominal classes; g6 has 17 modal labels and hill2 10.11 over 200; g5 and g7 show no collision collapse",
    "mask_detector": "one core regularity feature interval_cv gives auc 1.000 for g3 and g6; the core panel gives 0.529 for g5 and 0.512 for g7; selected action_entropy gives 0.921 for g5 and 0.942 for g7",
    "representation_dependence": "the ceiling falls to 0.32 with temporal features removed and to 0.0533 with sequence only; rf uses all 51 features, so only the full feature ceiling bounds it",
    "rf_plurality": "rf top1 0.386667 equals the tie aware ceiling; it is 1.000 on 40 unique windows and 0.342857 on 560 tied windows; the ceiling is stable for rounding precision 2 to 12 decimals and across test windows"
  },
